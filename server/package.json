{
  "name": "auth-core",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/app.js",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:gen": "prisma generate",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "init:system": "ts-node scripts/initialize-system-admin.ts",
    "init:admin": "ts-node scripts/initialize-admin.ts",
    "demo:exp": "ts-node scripts/demo-experience-tenant.ts",
    "test:system": "ts-node scripts/system-test.ts",
    "clear:db": "ts-node scripts/clear-database.ts",
    "clear:all": "ts-node scripts/clear-all-database.ts",
    "generate:data": "ts-node scripts/generate-test-data.ts",
    "generate:complete": "ts-node scripts/generate-complete-test-data.ts",
    "test:api": "ts-node tests/api-test.ts",
    "test:complete": "ts-node tests/complete-api-test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/ali-oss": "^6.23.3",
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "sharp": "^0.33.5",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
